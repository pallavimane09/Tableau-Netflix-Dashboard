      <aliases enabled='yes' />
      <column caption='Content Age' datatype='integer' name='[Calculation_0500051980431360]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='YEAR([Date_added]) - [Release_year]' />
      </column>
      <column caption='Recent Content' datatype='string' name='[Calculation_0500051980562433]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Release_year] &gt;= 2018 THEN&#13;&#10;&quot;Recent&quot;&#13;&#10;ELSE&#13;&#10;&quot;Older&quot;&#13;&#10;END' />
      </column>
      <column caption='Country Clean' datatype='string' name='[Calculation_0500051980693506]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([Country]) OR TRIM([Country]) = &quot;&quot;&#13;&#10;THEN &quot;Unknown&quot;&#13;&#10;ELSE [Country]&#13;&#10;END' />
      </column>
      <column caption='Rating Clean' datatype='string' name='[Calculation_0500051980775427]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([Rating]) OR TRIM([Rating]) = &quot;&quot;&#13;&#10;THEN &quot;Unknown&quot;&#13;&#10;ELSE [Rating]&#13;&#10;END' />
      </column>
      <column caption='Date' datatype='date' name='[Calculation_1304069851103232]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE([Date_added])' />
      </column>
      <column caption='Added Year' datatype='integer' name='[Calculation_1304069851299841]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='YEAR([Date_added])' />
      </column>
      <column caption='Added Month' datatype='datetime' name='[Calculation_1304069851439106]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,[Date_added])' />
      </column>
      <column caption='Movie Duration Minutes' datatype='integer' name='[Calculation_1304069851635715]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Type] = &quot;Movie&quot;&#13;&#10;THEN&#13;&#10;    INT(REPLACE([Duration],&quot; min&quot;,&quot;&quot;))&#13;&#10;END' />
      </column>
      <column caption='Average Movie Duration' datatype='real' name='[Calculation_1304069851738116]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Calculation_1304069851635715])' />
      </column>
      <column caption='TV Seasons' datatype='integer' name='[Calculation_1304069851815941]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Type] = &quot;TV Show&quot;&#13;&#10;THEN&#13;&#10;    INT(&#13;&#10;        REPLACE(&#13;&#10;            REPLACE([Duration],&quot; Seasons&quot;,&quot;&quot;),&#13;&#10;            &quot; Season&quot;,&quot;&quot;&#13;&#10;        )&#13;&#10;    )&#13;&#10;END' />
      </column>
      <column caption='Average TV Seasons' datatype='real' name='[Calculation_1304069851897862]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Calculation_1304069851815941])' />
      </column>
      <column caption='Total Titles' datatype='integer' name='[Calculation_3080039285084160]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Show_ID])' />
      </column>
      <column caption='Total Movies' datatype='integer' name='[Calculation_3080039290695682]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [Type] = &quot;Movie&quot;&#13;&#10;    THEN [Show_ID]&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Total TV Shows ' datatype='integer' name='[Calculation_3080039297306627]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [Type] = &quot;TV Show&quot;&#13;&#10;    THEN [Show_ID]&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Movie %' datatype='real' default-format='p0.00%' name='[Calculation_3080039298531333]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_3080039290695682] / [Calculation_3080039285084160]' />
      </column>
      <column caption='TV Show %' datatype='real' default-format='p0.00%' name='[Calculation_3080039299915782]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_3080039297306627] / [Calculation_3080039285084160]' />
      </column>
      <column caption='Peak Year' datatype='string' name='[Calculation_3080039311380491]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF COUNTD([Show_ID]) =&#13;&#10;WINDOW_MAX(COUNTD([Show_ID]))&#13;&#10;THEN &quot;Peak Year&quot;&#13;&#10;ELSE &quot;Other&quot;&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Total Show Id ' datatype='integer' name='[Calculation_3080039320260625]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Show_ID])' />
      </column>
      <column caption='Content Mix --Percentage of Total' datatype='real' name='[Calculation_3080039321100306]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Show_ID]) / TOTAL(COUNTD([Show_ID]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Titles Added' datatype='integer' name='[Calculation_3080039366455321]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Show_ID])' />
      </column>
      <column caption='Titles Released' datatype='integer' name='[Calculation_3080039366557722]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF NOT ISNULL([Release_year])&#13;&#10;    THEN [Show_ID]&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <column caption='Date added' datatype='date' name='[Date_added]' role='dimension' type='ordinal' />
      <column caption='Listed in - Split 1' datatype='string' name='[Listed_in - Split 1]' role='dimension' type='nominal' user:SplitFieldIndex='1' user:SplitFieldOrigin='[federated.1r5gfhp1ytv5c21bu7eph14gtn0p].[Listed_in]'>
        <calculation class='tableau' formula='TRIM( SPLIT( [Listed_in], &quot;,&quot;, 1 ) )' />
      </column>
      <column caption='Listed in' datatype='string' name='[Listed_in]' role='dimension' type='nominal' />
      <column caption='Release year' datatype='integer' name='[Release_year]' role='dimension' type='quantitative' />
